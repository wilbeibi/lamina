HERE = Path(__file__).resolve().parent
THEME = HERE / 'theme'
VENDOR_LIST = HERE / 'vendor.txt'

WARNINGS = []


def warn(msg):
    WARNINGS.append(msg)
    print(f'lamina: {msg}', file=sys.stderr)


def die(msg, code=1):
    print(f'lamina: {msg}', file=sys.stderr)
    sys.exit(code)


# ----------------------------------------------------------------- config --

LANG_DEFAULTS = {
    'en': {'name': 'EN', 'updated': 'updated', 'missing': 'no {name} version yet'},
    'zh': {'name': '中文', 'updated': '更新', 'missing': '暂无{name}版'},
}

SITE_DEFAULTS = {
    'name': 'site', 'description': '', 'url': '', 'author': '', 'lang': 'en',
    'output': 'output', 'glossary': '', 'toc_min': 3,
}


def load_site(root):
    p = root / 'site.toml'
    if not p.exists():
        die(f'no site config at {p}')
    cfg = tomllib.loads(p.read_text(encoding='utf-8'))
    site = dict(SITE_DEFAULTS)
    site.update({k: v for k, v in cfg.items() if k not in ('category', 'langs')})
    langs = {k: dict(v) for k, v in LANG_DEFAULTS.items()}
    for k, v in cfg.get('langs', {}).items():
        langs.setdefault(k, dict(LANG_DEFAULTS['en'], name=k.upper())).update(v)
    site['langs'] = langs
    cats = []
    for i, c in enumerate(cfg.get('category', [])):
        if 'dir' not in c:
            die('every [[category]] needs a dir')
        d = {'title': c['dir'], 'description': '', 'lang': site['lang'],
             'translations': [], 'index': 'index.html' if i == 0 else f"{c['dir']}.html",
             'atom': False, 'math': True, 'toc': False, 'glossary': site['glossary'],
             'index_page': ''}
        d.update(c)
        for lang in [d['lang'], *d['translations']]:
            if lang not in langs:
                die(f"category {d['dir']}: unknown language {lang!r} (add [langs.{lang}] to site.toml)")
        if d['index_page']:
            # the named page becomes the landing page; the category list moves
            # to the category's own index name so navigation still reaches it.
            if i != 0:
                die(f"category {d['dir']}: index_page is only for the first category, the landing page")
            if 'index' in c:
                die(f"category {d['dir']}: set index_page or index, not both")
            d['index'] = f"{d['dir']}.html"
        cats.append(d)
    if not cats:
        die('site.toml needs at least one [[category]]')
    site['category'] = cats
    return site


# ------------------------------------------------------------------ pages --

@dataclass(slots=True)
class Page:
    src: Path
    cat: dict
    date: str
    slug: str
    lang: str
    canonical: bool
    out: str
    assets: Path
    # filled in by parse, render_body, stamps, decorate
    title: str = ''
    body: str = ''
    description: str = ''
    html: str = ''
    headings: list = field(default_factory=list)   # (level, id, text)
    notes: list = field(default_factory=list)      # (id, html)
    mermaid: bool = False
    math: bool = False
    pv: dict = field(default_factory=dict)         # anchor -> (title, preview)
    ids: set = field(default_factory=set)
    meta: str = ''
    atom_updated: str = ''
    pops: str = ''
    toc: str = ''
    terms: dict | None = None                      # glossary pages only


NAME_RE = re.compile(r'^(\d{4}-\d{2}-\d{2})-(.+)$')


def discover(root, site):
    pages = []
    for cat in site['category']:
        d = root / 'pages' / cat['dir']
        if not d.is_dir():
            warn(f'category directory missing: {d}')
            continue
        for md in sorted(d.glob('*.md')):
            base = md.stem
            if base.startswith('_'):
                continue                      # draft
            m = NAME_RE.match(base)
            if not m:
                warn(f'{md}: not YYYY-MM-DD-slug.md, skipped')
                continue
            date, slug = m.groups()
            lang = cat['lang']
            if '.' in slug:
                core, suf = slug.rsplit('.', 1)
                if suf in site['langs']:
                    if suf == cat['lang']:
                        die(f"{md}: .{suf} suffix, but {cat['dir']} is already {suf}-canonical")
                    if suf not in cat['translations']:
                        die(f"{md}: {cat['dir']} declares no {suf} translations (site.toml)")
                    slug, lang = core, suf
            canonical = lang == cat['lang']
            out = f'{slug}.html' if canonical else f'{slug}.{lang}.html'
            pages.append(Page(src=md, cat=cat, date=date, slug=slug, lang=lang,
                              canonical=canonical, out=out, assets=d / f'{date}-{slug}'))
    seen = {}
    for p in pages:
        if p.out in seen:
            die(f'{p.src} and {seen[p.out].src} would both build {p.out}')
        seen[p.out] = p
    canon = {(p.cat['dir'], p.slug) for p in pages if p.canonical}
    for p in pages:
        if not p.canonical and (p.cat['dir'], p.slug) not in canon:
            warn(f"{p.src.name}: translation without a {p.cat['lang']} canonical page")
    return pages


TAG = re.compile(r'<[^>]+>')


def parse(p):
    lines = p.src.read_text(encoding='utf-8').split('\n')
    title, body, fence = None, lines, None
    for i, ln in enumerate(lines):
        f = FENCE.match(ln)
        if fence:
            if f and f.group(1)[0] == fence:
                fence = None
        elif f:
            fence = f.group(1)[0]
        elif ln.startswith('# '):
            title, body = ln[2:].strip(), lines[i + 1:]
            break
    p.title = title or p.slug
    p.body = '\n'.join(body)


CJK = r'[\u2e80-\u9fff\uf900-\ufaff\uff00-\uffef]'


def describe(md, tokens, env):
    """The first top-level paragraph, as plain text: the page description."""
    for i, t in enumerate(tokens):
        if t.type == 'paragraph_open' and t.level == 0:
            s = html.unescape(TAG.sub('', md.renderer.renderInline(tokens[i + 1].children, md.options, env)))
            s = re.sub(f'(?<={CJK})\n(?={CJK})', '', s)
            return clip(re.sub(r'\s+', ' ', s).strip(), 160)
    return ''


def clip(s, n):
    if len(s) <= n:
        return s
    cut = s[:n]
    if ' ' in cut[n // 2:]:
        cut = cut[:cut.rfind(' ')]
    return cut.rstrip(' ,;:，；：') + '…'


# -------------------------------------------------------------- markdown --

FENCE = re.compile(r'^\s{0,3}(`{3,}|~{3,})')
CALLOUT_START = re.compile(r'^\s{0,3}>\s*\[!(NOTE|IMPORTANT|WARNING)\](?:\s+(.*?))?\s*$', re.I)
CALLOUT_LINE = re.compile(r'^\s{0,3}> ?(.*)$')


def callouts(text):
    """Turn a small Obsidian-compatible callout subset into semantic HTML."""
    lines, out, fence, i = text.split('\n'), [], None, 0
    while i < len(lines):
        ln = lines[i]
        f = FENCE.match(ln)
        if f:
            fence = None if fence else f.group(1)[0]
            out.append(ln)
            i += 1
            continue
        start = None if fence else CALLOUT_START.match(ln)
        if not start:
            out.append(ln)
            i += 1
            continue
        kind = start.group(1).lower()
        title = start.group(2) or kind.title()
        body, i = [], i + 1
        while i < len(lines):
            q = CALLOUT_LINE.match(lines[i])
            if not q:
                break
            body.append(q.group(1))
            i += 1
        out.extend([
            f'<aside class="callout callout-{kind}">',
            f'<p class="callout-title">{html.escape(title)}</p>',
            '', *body, '', '</aside>',
        ])
    return '\n'.join(out)


# [[wiki links]] render to a placeholder tag: resolving them needs every page
# parsed first, so decorate() rewrites <x-wikilink> once the site is known.
def wikilinks(md):
    """[[target]] and [[target|label]] -> <x-wikilink data-target="...">."""
    def rule(state, silent):
        src, pos = state.src, state.pos
        if not src.startswith('[[', pos):
            return False
        end = src.find(']]', pos + 2)
        if end < 0 or set('[]') & set(src[pos + 2:end]):
            return False
        target, _, label = src[pos + 2:end].partition('|')
        if not silent:
            t = state.push('wikilink', 'x-wikilink', 0)
            t.attrSet('data-target', target.strip())
            t.content = (label or target).strip()
        state.pos = end + 2
        return True

    def render(self, tokens, idx, opts, env):
        t = tokens[idx]
        target = html.escape(t.attrGet('data-target'), quote=False).replace('"', '&quot;')
        return (f'<x-wikilink data-target="{target}">'
                f'{html.escape(t.content, quote=False)}</x-wikilink>')

    md.inline.ruler.before('link', 'wikilink', rule)
    md.add_render_rule('wikilink', render)


@functools.cache
def markdown(math):
    md = (MarkdownIt('commonmark', {'html': True, 'linkify': True, 'xhtmlOut': False})
          .enable(['table', 'strikethrough', 'linkify'])
          .use(tasklists_plugin).use(footnote_plugin).use(wikilinks))
    # autolink only a real scheme. Never a bare e-mail, never a bare domain --
    # prose is full of "fly.io" and "DESIGN.md" that must stay text.
    md.linkify.set({'fuzzy_email': False, 'fuzzy_link': False})
    md.add_render_rule('s_open', lambda s, t, i, o, e: '<del>')
    md.add_render_rule('s_close', lambda s, t, i, o, e: '</del>')

    # footnotes in our markup: numbered refs with hover popups, a plain
    # <section class="footnotes"> at the end, no <hr>.
    def fn_id(t):
        return str(t.meta['id'] + 1) + (f"-{t.meta['subId'] + 1}" if t.meta.get('subId') else '')

    md.add_render_rule('footnote_ref', lambda s, t, i, o, e: (
        f'<sup class="fn" id="fnref-{fn_id(t[i])}"><a href="#fn-{t[i].meta["id"] + 1}" '
        f'data-pop="pop-fn-{t[i].meta["id"] + 1}">{t[i].meta["id"] + 1}</a></sup>'))
    md.add_render_rule('footnote_block_open', lambda s, t, i, o, e: '<section class="footnotes"><ol>')
    md.add_render_rule('footnote_block_close', lambda s, t, i, o, e: '</ol></section>\n')
    md.add_render_rule('footnote_open', lambda s, t, i, o, e: f'<li id="fn-{t[i].meta["id"] + 1}">')
    md.add_render_rule('footnote_close', lambda s, t, i, o, e: '</li>')
    md.add_render_rule('footnote_anchor', lambda s, t, i, o, e: (
        f' <a href="#fnref-{fn_id(t[i])}" class="fnback" aria-label="back">↩</a>'))
    if math:
        # no space inside the delimiters, no digit hugging them -- keeps
        # "$5-$10" and "raised $Y @ $Z" in prose out of math
        md.use(dollarmath_plugin, double_inline=True,
               allow_space=False, allow_digits=False)

        # MathJax delimiters, emitted directly. Display blocks get their own
        # div (scrolls when wide); a labelled block stays inline in a <p> so
        # the label can follow it.
        def inline(self, tokens, idx, opts, env):
            return f'<span class="math">\\({html.escape(tokens[idx].content)}\\)</span>'

        def display(self, tokens, idx, opts, env):
            return f'<span class="math">\\[{html.escape(tokens[idx].content.strip())}\\]</span>'

        def block(self, tokens, idx, opts, env):
            return f'<div class="math">\\[{html.escape(tokens[idx].content.strip())}\\]</div>\n'

        def block_label(self, tokens, idx, opts, env):
            return f'<p>{display(self, tokens, idx, opts, env)} ({tokens[idx].info})</p>\n'

        md.add_render_rule('math_inline', inline)
        md.add_render_rule('math_inline_double', display)
        md.add_render_rule('math_block', block)
        md.add_render_rule('math_block_label', block_label)
    return md


def render_body(p):
    text = callouts(p.body)
    md, env = markdown(p.cat['math']), {}
    tokens = md.parse(text, env)
    h = md.renderer.render(tokens, md.options, env)
    p.description = describe(md, tokens, env)

    # heading ids: the heading text itself, whitespace -> '-', deduped.
    used, heads = {}, []

    def hid(m):
        lvl, inner = m.group(1), m.group(2)
        base = re.sub(r'\s+', '-', TAG.sub('', inner).strip()) or 'section'
        n = used.get(base, 0)
        used[base] = n + 1
        ident = base if n == 0 else f'{base}-{n + 1}'
        heads.append((int(lvl), html.unescape(ident), html.unescape(TAG.sub('', inner)).strip()))
        return f'<h{lvl} id="{ident.replace(chr(34), "&quot;")}">{inner}</h{lvl}>'
    h = re.sub(r'<h([2-4])>(.*?)</h\1>', hid, h, flags=re.S)
    p.headings = heads

    # ```mermaid fences -> <pre class="mermaid"> (rendered client-side)
    h, n = re.subn(r'<pre><code class="language-mermaid">(.*?)</code></pre>', r'<pre class="mermaid">\1</pre>', h, flags=re.S)
    p.mermaid = n > 0

    p.math = 'class="math"' in h

    # GFM tables get the same scroll/breakout wrapper hand-written ones use
    h = re.sub(r'<table>\n<thead>(.*?)</table>', r'<div class="t"><table>\n<thead>\1</table></div>', h, flags=re.S)

    # footnote bodies feed the hover popups (minus the back link)
    p.notes = [(n, re.sub(r' <a href="#fnref-[^"]*" class="fnback"[^<]*</a>', '', body))
               for n, body in re.findall(r'<li id="fn-(\d+)">(.*?)</li>', h, re.S)]
    # ...and a sidenote after the first ref, shown in the margin when wide
    # (style.css). Notes with block content stay popup + endnote only.
    for n, body in p.notes:
        if re.search(r'<(pre|ul|ol|div|blockquote|table)\b', body):
            continue
        inner = re.sub(r'</p>\s*<p>', '<br>', body.strip()).removeprefix('<p>').removesuffix('</p>')
        at = h.find('</sup>', h.find(f'<sup class="fn" id="fnref-{n}">')) + 6
        h = f'{h[:at]}<span class="sn"><b>{n}</b> {inner}</span>{h[at:]}'
    p.html = h

    # previews: '' -> (title, description); heading id -> (heading, first paragraph)
    pv = {'': (p.title, p.description)}
    for lvl, ident, text in p.headings:
        pos = h.find(f'<h{lvl} id="{html.escape(ident, quote=False).replace(chr(34), "&quot;")}">')
        para = ''
        if pos >= 0:
            seg = h[pos:]
            nxt = re.search(r'<h[2-4]', seg[10:])
            seg = seg[:nxt.start() + 10] if nxt else seg
            m = re.search(r'<p>(.*?)</p>', seg, re.S)
            if m:
                para = clip(html.unescape(TAG.sub('', m.group(1))).strip(), 240)
        pv[ident] = (text, para)
    p.pv = pv
    p.ids = {html.unescape(i) for i in re.findall(r'\sid="([^"]*)"', h)}


# ------------------------------------------------------------- decorate --

class Ctx:
    def __init__(self, root, site, pages, outdir):
        self.root, self.site, self.pages, self.outdir = root, site, pages, outdir
        self.by_out = {p.out: p for p in pages}
        self.indexes = {c['index'] for c in site['category']}
        if site['category'][0]['index_page']:
            self.indexes.add('index.html')      # written from the landing page
        self.by_slug = {}
        for p in pages:
            self.by_slug.setdefault((p.cat['dir'], p.slug), {})[p.lang] = p
        self.feed = any(c['atom'] for c in site['category']) and bool(site['url'])
        self.vendor_used = set()
        self.cdn_warned = set()
        self._vendor = None

    def find_page(self, slug, lang):
        hits = [v for (cat, s), v in self.by_slug.items() if s == slug]
        if not hits:
            return None
        v = hits[0]
        return v.get(lang) or next(iter(v.values()))

    def glossary_for(self, page):
        slug = page.cat['glossary']
        if not slug:
            return None
        g = self.find_page(slug, page.lang)
        if g is None:
            return None
        if g.terms is None:
            g.terms = {text.lower(): ident for lvl, ident, text in g.headings if lvl <= 3}
        return g

    def vendor_url(self, name):
        if self._vendor is None:
            self._vendor = {}
            if VENDOR_LIST.exists():
                for ln in VENDOR_LIST.read_text().splitlines():
                    if ln.strip() and not ln.startswith('#'):
                        n, url = ln.split(None, 1)
                        self._vendor[n] = url.strip()
        local = self.root / 'theme' / 'vendor' / name
        if not local.exists():
            local = THEME / 'vendor' / name
        if local.exists():
            self.vendor_used.add(local)
            return f'/vendor/{name}'
        url = self._vendor.get(name)
        if not url:
            die(f'no vendor entry for {name} in {VENDOR_LIST}')
        if name not in self.cdn_warned:
            self.cdn_warned.add(name)
            print(f'lamina: {name} loads from CDN (run `lamina vendor` to self-host)', file=sys.stderr)
        return url


LINK_RE = re.compile(r'<a\b([^>]*?)\shref="([^"]*)"([^>]*)>')
WL_RE = re.compile(r'<x-wikilink data-target="([^"]*)">(.*?)</x-wikilink>', re.S)
INTERNAL_RE = re.compile(r'^/?([^/#?]+\.html)?(?:#(.*))?$')


def page_asset(ctx, href) -> tuple[bool, bool]:
    """Return (known page-asset URL, source exists) for a local href."""
    u = urllib.parse.urlsplit(html.unescape(href))
    if u.scheme or u.netloc or not u.path:
        return False, False
    parts = tuple(x for x in urllib.parse.unquote(u.path).lstrip('/').split('/') if x not in ('', '.'))
    if len(parts) < 2 or '..' in parts:
        return False, False
    pages = [p for p in ctx.pages if p.slug == parts[0]]
    if not pages:
        return False, False
    return True, any(p.assets.joinpath(*parts[1:]).exists() for p in pages)


def decorate(p, ctx):
    pops, keys = {}, {}

    def popfor(tp, anchor):
        if tp is p and anchor == '':
            return None
        key = (tp.out, anchor)
        if key in keys:
            return keys[key]
        pv = tp.pv.get(anchor)
        if pv is None:
            return None
        head, body = pv
        pid = f'pop-{len(pops) + 1}'
        ctxline = '' if anchor == '' or tp is p else f'<p class="pop-c">{html.escape(tp.title)}</p>'
        pops[pid] = (ctxline + f'<p class="pop-t">{html.escape(head)}</p>'
                     + (f'<p>{html.escape(body)}</p>' if body else ''))
        keys[key] = pid
        return pid

    def wl(m):
        target, label = html.unescape(m.group(1)), m.group(2)
        pg, _, anchor = target.partition('#')
        tp = p if pg == '' else ctx.find_page(pg, p.lang)
        if tp is None and not anchor:
            g = ctx.glossary_for(p)
            if g and target.lower() in g.terms:
                tp, anchor = g, g.terms[target.lower()]
        if tp is None or (anchor and anchor not in tp.pv):
            warn(f'{p.src.name}: unresolved wikilink [[{target}]]')
            return f'<span class="wl-missing">{label}</span>'
        href = ('' if tp is p else tp.out) + (f'#{urllib.parse.quote(anchor)}' if anchor else '')
        pid = popfor(tp, anchor)
        attr = f' data-pop="{pid}"' if pid else ''
        return f'<a href="{href}" class="wl"{attr}>{label}</a>'
    h = WL_RE.sub(wl, p.html)

    def lk(m):
        a1, href, a3 = m.groups()
        if 'data-pop' in a1 + a3:
            return m.group(0)
        im = INTERNAL_RE.match(urllib.parse.unquote(html.unescape(href)))
        if not im:
            known, exists = page_asset(ctx, href)
            if known and not exists:
                warn(f'{p.src.name}: dead asset link {href}')
            return m.group(0)
        file, anchor = im.group(1), im.group(2) or ''
        tp = p if not file else ctx.by_out.get(file)
        if tp is None:
            if file not in ctx.indexes and not (ctx.root / 'static' / file).exists():
                warn(f'{p.src.name}: dead link {href}')
            return m.group(0)
        if anchor and anchor not in tp.pv and anchor not in tp.ids:
            warn(f'{p.src.name}: dead anchor {href}')
            return m.group(0)
        pid = popfor(tp, anchor)
        if not pid:
            return m.group(0)
        return f'<a{a1} href="{href}"{a3} data-pop="{pid}">'
    h = LINK_RE.sub(lk, h)

    for ident, body in p.notes:
        pops[f'pop-fn-{ident}'] = body
    p.html = h
    p.pops = ('<div hidden>' + ''.join(f'<template id="{k}">{v}</template>' for k, v in pops.items()) + '</div>') if pops else ''

    p.toc = ''
    h2 = [(i, t) for lvl, i, t in p.headings if lvl == 2]
    if p.cat['toc'] and len(h2) >= ctx.site['toc_min']:
        shown = [(lvl, i, t) for lvl, i, t in p.headings if lvl in (2, 3)]
        items = ''.join(f'<li class="toc-h{lvl}"><a href="#{urllib.parse.quote(i)}">{html.escape(t)}</a></li>'
                        for lvl, i, t in shown)
        p.toc = (f'<nav class="toc" aria-label="Contents"><p class="toc-title">Contents</p>'
                 f'<ol>{items}</ol></nav>')


# ------------------------------------------------------------ git dates --

def git(root, *args):
    try:
        r = subprocess.run(['git', '-C', str(root), *args], capture_output=True, text=True)
    except FileNotFoundError:
        return ''
    return r.stdout.strip() if r.returncode == 0 else ''


def stamps(p, root, site):
    rel = p.src.relative_to(root)
    log = git(root, 'log', '--follow', '--diff-filter=AM', '--format=%cI', '--', rel).splitlines()
    first = log[-1] if log else ''           # the commit that added the file
    last = log[0] if len(log) > 1 else ''    # the latest edit, if any
    upd = ''
    if last and last[:10] != p.date:
        label = site['langs'][p.lang].get('updated', 'updated')
        upd = f' · {label} <time datetime="{last[:10]}">{last[:10]}</time>'
    p.meta = f'<time datetime="{p.date}">{p.date}</time>{upd}'
    p.atom_updated = last or first or f'{p.date}T00:00:00Z'


# ------------------------------------------------------------- templates --

def tpl(ctx, name):
    for base in (ctx.root / 'theme', THEME):
        f = base / name
        if f.exists():
            return f.read_text(encoding='utf-8')
    die(f'template missing: {name}')


def render(t, vars):
    return re.sub(r'\{\{(\w+)\}\}', lambda m: str(vars.get(m.group(1), '')), t)


SEP = '<span class="sep">·</span>'


def href_of(cat):
    return '/' if cat['index'] == 'index.html' else f"/{cat['index']}"

MATHJAX_CFG = ("<script>window.MathJax={tex:{inlineMath:[['\\\\(','\\\\)']],displayMath:[['\\\\[','\\\\]']],"
               "processEscapes:false},svg:{fontCache:'global'},options:{skipHtmlTags:"
               "['script','noscript','style','textarea','pre','code']}};</script>")


def langnav(p, ctx) -> tuple[str, str]:
    cat, L = p.cat, ctx.site['langs']
    parts = []
    if cat['index'] != 'index.html':
        parts.append(f'<a href="{href_of(cat)}">{html.escape(cat["title"])}</a>')
    langs = [cat['lang'], *cat['translations']]
    alt = ''
    if len(langs) > 1:
        versions = ctx.by_slug[(cat['dir'], p.slug)]
        for lang in langs:
            name = L[lang]['name']
            if lang == p.lang:
                parts.append(f'<strong>{name}</strong>')
            elif lang in versions:
                parts.append(f'<a href="{versions[lang].out}" hreflang="{lang}">{name}</a>')
            else:
                miss = L[p.lang].get('missing', 'no {name} version yet').format(name=name)
                parts.append(f'<span class="off" title="{html.escape(miss, quote=True)}">{name}</span>')
        if len(versions) > 1 and cat['lang'] in versions:
            alt = ''.join(f'<link rel="alternate" hreflang="{l}" href="/{versions[l].out}">' for l in langs if l in versions)
            alt += f'<link rel="alternate" hreflang="x-default" href="/{versions[cat["lang"]].out}">'
    nav = f'<span class="langnav">{SEP.join(parts)}</span>' if parts else ''
    return nav, alt


def page_html(p, ctx):
    site = ctx.site
    nav, alt = langnav(p, ctx)
    head = [alt]
    if ctx.feed:
        head.append(f'<link rel="alternate" type="application/atom+xml" title="{html.escape(site["name"])}" href="/atom.xml">')
    if p.math:
        head.append(MATHJAX_CFG)
        head.append(f'<script defer src="{ctx.vendor_url("tex-svg.js")}"></script>')
    if p.mermaid:
        head.append(f'<script defer src="{ctx.vendor_url("mermaid.min.js")}"></script>')
    head.append('<script defer src="/lamina.js"></script>')
    footer = f'<a href="{href_of(p.cat)}">← {html.escape(p.cat["title"])}</a>'
    if ctx.feed:
        footer += ' · <a href="/atom.xml">atom</a>'
    return render(tpl(ctx, 'page.html'), {
        'lang': p.lang, 'site_name': html.escape(site['name']), 'title': html.escape(p.title),
        'description': html.escape(p.description, quote=True), 'head': '\n'.join(x for x in head if x),
        'nav': nav, 'meta': p.meta, 'toc': p.toc, 'content': p.html, 'pops': p.pops, 'footer': footer,
    })


def index_html(cat, ctx):
    site = ctx.site
    items = [p for p in ctx.pages if p.cat is cat and p.canonical]
    items.sort(key=lambda p: (p.date, p.src.name), reverse=True)
    item_t = tpl(ctx, 'index-item.html')
    lis = ''.join(render(item_t, {'date': p.date, 'href': p.out, 'title': html.escape(p.title),
                                  'description': html.escape(p.description, quote=True)}) for p in items)
    sec = []
    for c in site['category']:
        t = html.escape(c['title'])
        sec.append(f'<strong>{t}</strong>' if c is cat else f'<a href="{href_of(c)}">{t}</a>')
    secnav = f'<span class="secnav">{SEP.join(sec)}</span>' if len(sec) > 1 else ''
    first = site['category'][0]
    at_root = cat is first and not cat['index_page']
    if at_root:
        footer = '<a href="/atom.xml">atom</a>' if ctx.feed else ''
    else:
        label = site['name'] if cat is first else first['title']
        back = '/' if cat is first else href_of(first)
        footer = f'<a href="{back}">← {html.escape(label)}</a>'
    head = [f'<link rel="alternate" type="application/atom+xml" title="{html.escape(site["name"])}" href="/atom.xml">'] if ctx.feed else []
    title = html.escape(site['name']) if cat is first else f'{html.escape(cat["title"])} — {html.escape(site["name"])}'
    desc = cat['description'] or (site['description'] if cat is first else '')
    return render(tpl(ctx, 'index.html'), {
        'lang': cat['lang'], 'site_name': html.escape(site['name']), 'title': title,
        'description': html.escape(desc, quote=True), 'head': '\n'.join(head),
        'secnav': secnav, 'items': lis, 'footer': footer,
        'brand': f'<strong>{html.escape(site["name"])}</strong>' if at_root else f'<a href="/">{html.escape(site["name"])}</a>',
    })


def atom_xml(ctx):
    site = ctx.site
    entries = [p for p in ctx.pages if p.cat['atom'] and p.canonical]
    entries.sort(key=lambda p: (p.date, p.src.name), reverse=True)
    url = site['url'].rstrip('/')
    item_t = tpl(ctx, 'atom-item.xml')
    items = ''.join(render(item_t, {
        'title': html.escape(p.title), 'updated': p.atom_updated,
        'url': f'{url}/' if p.out == 'index.html' else f'{url}/{p.out}',
        'summary': html.escape(p.description)}) for p in entries)
    updated = max((p.atom_updated for p in entries), default='1970-01-01T00:00:00Z')
    return render(tpl(ctx, 'atom.xml'), {
        'site_name': html.escape(site['name']), 'description': html.escape(site['description']),
        'url': url, 'author': html.escape(site['author']), 'updated': updated, 'items': items,
    })


# ---------------------------------------------------------------- build --

def safe_outdir(root, out):
    out = out.resolve()
    if out == root.resolve() or root.resolve().is_relative_to(out):
        die(f'refusing to use {out} as output: it contains the site')
    if (out / 'site.toml').exists() or (out / 'pages').is_dir():
        die(f'refusing to wipe {out}: it looks like a site, not a build')
    return out


def theme_file(root, name):
    for base in (root / 'theme', THEME):
        if (base / name).exists():
            return base / name
    return None


def build(root, outdir=None):
    WARNINGS.clear()
    root = root.resolve()
    site = load_site(root)
    out = safe_outdir(root, Path(outdir) if outdir else root / site['output'])
    pages = discover(root, site)
    land = site['category'][0]
    if land['index_page']:
        pg = next((p for p in pages if p.cat is land and p.canonical and p.slug == land['index_page']), None)
        if pg is None:
            die(f"index_page {land['index_page']!r}: no such page in pages/{land['dir']}/")
        for q in pages:
            if q is not pg and q.out in ('index.html', land['index']):
                die(f'{q.src.name} would be overwritten by the landing page or the {land["dir"]} index')
        pg.out = 'index.html'
    ctx = Ctx(root, site, pages, out)
    if any(c['atom'] for c in site['category']) and not site['url']:
        warn('atom feed needs `url` in site.toml; feed skipped')
    for p in pages:
        parse(p)
        render_body(p)
        stamps(p, root, site)
    for p in pages:
        decorate(p, ctx)

    if out.exists():
        shutil.rmtree(out)
    out.mkdir(parents=True)
    for p in pages:
        (out / p.out).write_text(page_html(p, ctx), encoding='utf-8')
        if p.assets.is_dir():
            shutil.copytree(p.assets, out / p.slug, dirs_exist_ok=True)
    for cat in site['category']:
        (out / cat['index']).write_text(index_html(cat, ctx), encoding='utf-8')
    if ctx.feed:
        (out / 'atom.xml').write_text(atom_xml(ctx), encoding='utf-8')

    css = theme_file(root, 'style.css').read_text(encoding='utf-8')
    extra = root / 'theme' / 'site.css'
    if extra.exists():
        css += '\n/* site.css */\n' + extra.read_text(encoding='utf-8')
    (out / 'style.css').write_text(css, encoding='utf-8')
    for name in ('lamina.js', 'favicon.svg'):
        f = theme_file(root, name)
        if f:
            shutil.copy(f, out / name)
    if ctx.vendor_used:
        (out / 'vendor').mkdir()
        for f in ctx.vendor_used:
            shutil.copy(f, out / 'vendor' / f.name)
    static = root / 'static'
    if static.is_dir():
        for f in static.rglob('*.html'):
            if f.relative_to(static).as_posix() in ctx.by_out or f.name in ctx.indexes:
                warn(f'static/{f.relative_to(static)} shadows a generated page')
        shutil.copytree(static, out, dirs_exist_ok=True)
    n = len(pages)
    print(f'lamina: built {n} pages + {len(site["category"])} indexes -> {out}'
          + (f' ({len(WARNINGS)} warnings)' if WARNINGS else ''))
    return out


# ------------------------------------------------------------- commands --

def cmd_serve(out, port):
    import functools
    import http.server
    handler = functools.partial(http.server.SimpleHTTPRequestHandler, directory=str(out))
    handler.log_message = lambda *a, **k: None
    with http.server.ThreadingHTTPServer(('127.0.0.1', port), handler) as srv:
        print(f'lamina: serving {out} at http://127.0.0.1:{port}/  (Ctrl-C to stop)')
        try:
            srv.serve_forever()
        except KeyboardInterrupt:
            pass


def signature(root):
    sig = 0
    for base in (root / 'pages', root / 'theme', root / 'static', THEME):
        if base.is_dir():
            for f in base.rglob('*'):
                if f.is_file():
                    sig = max(sig, f.stat().st_mtime_ns)
    st = root / 'site.toml'
    if st.exists():
        sig = max(sig, st.stat().st_mtime_ns)
    return sig


def cmd_watch(root, outdir):
    last = None
    print('lamina: watching for changes (Ctrl-C to stop)')
    while True:
        sig = signature(root)
        if sig != last:
            last = sig
            try:
                build(root, outdir)
            except SystemExit:
                pass
            except Exception as e:
                print(f'lamina: build failed: {e!r}', file=sys.stderr)
        try:
            time.sleep(1)
        except KeyboardInterrupt:
            return


def cmd_new(root, category, slug, title):
    site = load_site(root)
    cats = {c['dir']: c for c in site['category']}
    if category not in cats:
        die(f'unknown category {category!r}; site.toml has: {", ".join(cats)}')
    if not (slug := re.sub(r'[^a-z0-9.-]+', '-', slug.lower()).strip('-')):
        die('slug has no ascii letters or digits; pass one explicitly')
    f = root / 'pages' / category / f'{_date.today().isoformat()}-{slug}.md'
    if f.exists():
        die(f'{f} exists')
    f.parent.mkdir(parents=True, exist_ok=True)
    f.write_text(f'# {title or slug}\n\n', encoding='utf-8')
    print(f)


def cmd_vendor():
    dest = THEME / 'vendor'
    dest.mkdir(exist_ok=True)
    for ln in VENDOR_LIST.read_text().splitlines():
        if not ln.strip() or ln.startswith('#'):
            continue
        name, url = ln.split(None, 1)
        print(f'lamina: {url} -> {dest / name}')
        with urllib.request.urlopen(url.strip(), timeout=60) as r, open(dest / name, 'wb') as w:
            shutil.copyfileobj(r, w)


def main(argv=None):
    ap = argparse.ArgumentParser(prog='lamina', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('--root', default='.', help='site directory (default: cwd)')
    ap.add_argument('-o', '--output', help='output directory (default: ROOT/output)')
    sub = ap.add_subparsers(dest='cmd')
    sub.add_parser('build')
    sub.add_parser('check')
    s = sub.add_parser('serve')
    s.add_argument('--port', type=int, default=8000)
    sub.add_parser('watch')
    n = sub.add_parser('new')
    n.add_argument('category')
    n.add_argument('slug')
    n.add_argument('--title')
    sub.add_parser('vendor')
    a = ap.parse_args(argv)
    root = Path(a.root)
    cmd = a.cmd or 'build'
    if cmd == 'build':
        build(root, a.output)
    elif cmd == 'check':
        build(root, a.output)
        if WARNINGS:
            die(f'{len(WARNINGS)} warnings')
        print('lamina: check ok')
    elif cmd == 'serve':
        cmd_serve(build(root, a.output), a.port)
    elif cmd == 'watch':
        cmd_watch(root, a.output)
    elif cmd == 'new':
        cmd_new(root, a.category, a.slug, a.title)
    elif cmd == 'vendor':
        cmd_vendor()


if __name__ == '__main__':
    main()
